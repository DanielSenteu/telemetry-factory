{
  "name": "industrial-sync",
  "private": true,
  "packageManager": "pnpm@10.11.1",
  "scripts": {
    "dev": "pnpm --filter @industrial-sync/web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:db": "supabase test db",
    "db:reset": "supabase db reset",
    "db:push": "supabase db push",
    "agent": "pnpm --filter @industrial-sync/factory-agent agent",
    "simulator": "pnpm --filter @industrial-sync/factory-agent simulator"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "core-js"
    ]
  }
}